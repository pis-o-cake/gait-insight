# docker compose 가 읽는다. 이 파일을 .env 로 복사해 값을 채운다.
POSTGRES_DB=gait_insight
POSTGRES_USER=gait
POSTGRES_PASSWORD=change-me

# 로그인 쿠키 서명 키. 비우면 서버가 뜨지 않는다.
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12
WORKERS=2

# 시연용 계정. seed 가 만들고 로그인 화면 아래에 그대로 보여 준다. 비우면 만들지 않는다.
# WARNING: 화면에 공개되는 값이다. 로컬망 시연 밖에서는 비운다.
DEMO_LOGIN_ID=admin
DEMO_PASSWORD=0000
DEMO_DISPLAY_NAME=관리자
